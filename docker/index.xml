&lt;td style="vertical-align:top;padding:0;margin:0;border:0;;width:100%">
&lt;pre tabindex="0" style="color:#b0c4de;background-color:#282c34;-moz-tab-size:4;-o-tab-size:4;tab-size:4;">&lt;code class="language-cmd" data-lang="cmd">&lt;span style="display:flex;">&lt;span>docker search nginx --limit 5 --no-trunc
&lt;/span>&lt;/span>&lt;/code>&lt;/pre>&lt;/td>&lt;/tr>&lt;/table>
&lt;/div>
&lt;/div>&lt;h3 id="拉取镜像">拉取镜像&lt;a class="td-heading-self-link" href="#%e6%8b%89%e5%8f%96%e9%95%9c%e5%83%8f" aria-label="Heading self-link">&lt;/a>&lt;/h3>
&lt;blockquote>
&lt;p>Tips:&lt;/p>
&lt;p>​	&lt;code>docker pull&lt;/code> 命令是 &lt;code>docker image pull&lt;/code> 的别名。&lt;/p>&lt;/blockquote>
&lt;div class="highlight">&lt;div style="color:#b0c4de;background-color:#282c34;-moz-tab-size:4;-o-tab-size:4;tab-size:4;">
&lt;table style="border-spacing:0;padding:0;margin:0;border:0;">&lt;tr>&lt;td style="vertical-align:top;padding:0;margin:0;border:0;">
&lt;pre tabindex="0" style="color:#b0c4de;background-color:#282c34;-moz-tab-size:4;-o-tab-size:4;tab-size:4;">&lt;code>&lt;span style="white-space:pre;-webkit-user-select:none;user-select:none;margin-right:0.4em;padding:0 0.4em 0 0.4em;color:#58626f">1
&lt;/span>&lt;/code>&lt;/pre>&lt;/td>
&lt;td style="vertical-align:top;padding:0;margin:0;border:0;;width:100%">
&lt;pre tabindex="0" style="color:#b0c4de;background-color:#282c34;-moz-tab-size:4;-o-tab-size:4;tab-size:4;">&lt;code class="language-cmd" data-lang="cmd">&lt;span style="display:flex;">&lt;span>docker pull [OPTIONS] NAME[:TAG&lt;span style="color:#abb2bf">|@&lt;/span>DIGEST]
&lt;/span>&lt;/span>&lt;/code>&lt;/pre>&lt;/td>&lt;/tr>&lt;/table>
&lt;/div>
&lt;/div>&lt;p>示例&lt;/p>
&lt;pre tabindex="0">&lt;code># 拉取最新的版本的 Nginx 镜像
docker pull nginx:latest

# 拉取带有的5.7.44标签的 MySQL 镜像
docker pull mysql:5.7.44

# 拉取带有的1.22.2-alpine标签的 golang 镜像
docker pull golang:1.22.2-alpine
&lt;/code>&lt;/pre>&lt;h3 id="删除镜像">删除镜像&lt;a class="td-heading-self-link" href="#%e5%88%a0%e9%99%a4%e9%95%9c%e5%83%8f" aria-label="Heading self-link">&lt;/a>&lt;/h3>
&lt;blockquote>
